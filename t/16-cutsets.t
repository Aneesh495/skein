use strict;
use warnings;
use Test::More;
use Skein::BDD;
use Skein::Cutsets;
use Skein::BDD::Transform qw(restrict);

my $bdd = Skein::BDD->new([qw(a b c)]);
my ($a, $b, $c) = map { $bdd->variable($_) } qw(a b c);
my $root = $bdd->apply('or', $a, $bdd->apply('and', $b, $c));
my $cuts = Skein::Cutsets->new($bdd, $root);
ok($cuts->monotonicity->{monotone}, 'monotone event');
my $sets = $cuts->positive_sets;
is_deeply([sort map { join ',', @$_ } @$sets], ['a', 'b,c'], 'minimal cut sets');
my $signed = $cuts->prime_implicants;
is(scalar @$signed, 2, 'monotone prime count');
ok($cuts->verify_implicant($_), 'each prime independently irreducible') for @$signed;
my $xor = Skein::Cutsets->new($bdd, $bdd->apply('xor', $a, $b));
ok(!$xor->monotonicity->{monotone}, 'nonmonotone event recognized');
ok(!eval { $xor->positive_sets; 1 }, 'positive-only explanation rejected for XOR');
my $primes = $xor->prime_implicants;
is(scalar @$primes, 2, 'XOR has two signed primes');
ok($xor->verify_implicant($_), 'XOR signed prime irreducible') for @$primes;
my $consensus_root = $bdd->apply('or', $bdd->apply('and', $a, $b), $bdd->apply('and', $bdd->negate($a), $c));
my $consensus = Skein::Cutsets->new($bdd, $consensus_root);
my $all = $consensus->prime_implicants;
is(scalar @$all, 3, 'consensus prime included');
ok($consensus->verify_implicant($_), 'consensus primes checked') for @$all;
is(Skein::Cutsets->cube_mass({a => 1, b => 0}, {a => '1/3', b => '1/4'}), '1/4', 'conjunction probability');
is_deeply(Skein::Cutsets->new($bdd, 1)->positive_sets, [[]], 'certain event has empty cut');
is_deeply(Skein::Cutsets->new($bdd, 0)->positive_sets, [], 'impossible event has no cut');
done_testing;
