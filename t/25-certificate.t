use strict;
use warnings;
use Test::More;
use Skein::Model;
use Skein::Engine;
use Skein::Certificate;
use Skein::Util qw(deep_copy digest);

my $model = Skein::Model->from_text('noise a ~ 1/3; noise b ~ 1/4; node x = a ^ b; query q = P(x) do(x=0) factual(x);');
my $certificate = Skein::Certificate->create(Skein::Engine->new($model), 'q');
my $verified = Skein::Certificate->verify($model, $certificate);
ok($verified->{verified}, 'full source-world certificate verified');
is($verified->{worlds}, 4, 'all worlds checked');
is($verified->{probability}, '0', 'verified counterfactual result');
my $corrupt = deep_copy($certificate);
$corrupt->{payload}{result}{probability} = '1';
ok(!eval { Skein::Certificate->verify($model, $corrupt); 1 }, 'integrity tampering caught');
$corrupt->{sha256} = digest($corrupt->{payload});
ok(!eval { Skein::Certificate->verify($model, $corrupt); 1 }, 'rehashed false numeric claim caught');
my $forged = deep_copy($certificate);
$forged->{payload}{diagram}{roots}[0] = $forged->{payload}{diagram}{roots}[1];
$forged->{sha256} = digest($forged->{payload});
ok(!eval { Skein::Certificate->verify($model, $forged); 1 }, 'rehashed semantic forgery caught');
my $other = Skein::Model->from_text('noise a ~ 1/3; noise b ~ 1/4; node x = a | b; query q = P(x) do(x=0) factual(x);');
ok(!eval { Skein::Certificate->verify($other, $certificate); 1 }, 'different source rejected');
my $zero_prior = Skein::Model->from_text('noise a ~ 0; node x = a; query q = P(x);');
my $cert_zero = Skein::Certificate->create(Skein::Engine->new($zero_prior), 'q');
$cert_zero->{payload}{diagram}{roots}[0] = 0;
$cert_zero->{sha256} = digest($cert_zero->{payload});
ok(!eval { Skein::Certificate->verify($zero_prior, $cert_zero); 1 }, 'zero-weight worlds still checked for semantic equivalence');
done_testing;
