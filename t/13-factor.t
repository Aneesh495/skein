use strict;
use warnings;
use Test::More;
use Skein::Factor;
use Skein::Rat qw(text);

my $prior = Skein::Factor->new(['a'], {0 => '2/3', 1 => '1/3'});
my $equation = Skein::Factor->from_function([qw(a b)], sub { $_[0]{b} == 1 - $_[0]{a} ? 1 : 0 });
my $joint = $prior->multiply($equation);
is($joint->row_count, 2, 'sparse deterministic factor');
is(text($joint->total), '1', 'joint mass');
is_deeply($joint->sum_out('a')->rows, {0 => '1/3', 1 => '2/3'}, 'marginal elimination');
is_deeply($joint->condition({b => 1})->normalize->rows, {0 => '1'}, 'evidence normalization');
is(text($joint->value({a => 1, b => 1})), '0', 'implicit zero row');
my $reversed = Skein::Factor->new([qw(b a)], {'10' => '2/3', '01' => '1/3'});
is_deeply($reversed->rows, $joint->rows, 'scope permutations canonicalized');
my $scalar = Skein::Factor->scalar_factor('1/7');
is(text($scalar->multiply($joint)->total), '1/7', 'scalar multiplication');
is_deeply($joint->rename({a => 'z'})->variables, [qw(b z)], 'factor rename');
my $disjoint = Skein::Factor->new(['c'], {0 => '1/4', 1 => '3/4'});
is($joint->multiply($disjoint)->row_count, 4, 'Cartesian sparse join');
is_deeply($joint->multiply($disjoint)->sum_out([qw(a b)])->rows, $disjoint->rows, 'independent marginal');
is(text($joint->sum_out([qw(a b)])->total), '1', 'empty scope marginal');
ok(!eval { Skein::Factor->new(['a'], {'2' => 1}); 1 }, 'bad factor assignment');
ok(!eval { Skein::Factor->new(['a'], {'0' => '-1/2'}); 1 }, 'negative weight rejected');
ok(!eval { Skein::Factor->new(['a'], {'0' => 1, '1' => 1}, max_rows => 1); 1 }, 'row limit');
ok(!eval { Skein::Factor->scalar_factor(0)->normalize; 1 }, 'zero mass fails');
ok(!eval { $joint->sum_out('absent'); 1 }, 'unknown elimination variable');
ok(!eval { $joint->rename({a => 'b'}); 1 }, 'rename collision');
done_testing;
