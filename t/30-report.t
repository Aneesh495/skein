use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use Skein::Model;
use Skein::Engine;
use Skein::Report;
use Skein::Render;
use Skein::Util qw(read_text);
use Digest::SHA qw(sha256_hex);

my $model = Skein::Model->from_file('examples/rack.sk');
my $engine = Skein::Engine->new($model);
my $report = Skein::Report->new($engine);
my $data = $report->data;
is($data->{verification}{baseline}{status},'three_backends_agree','report computes independent verification');
is($data->{certificate}{value}{worlds},8,'report certificate checked');
is($data->{plan}{status},'available','repair evidence present');
my $html = $report->html($data);
like($html,qr/2599\/250000/,'computed baseline displayed');
like($html,qr/<!doctype html>/,'standalone HTML');
unlike($html,qr/<script\b/i,'no client scripting');
unlike($html,qr/(?:src|href)="https?:/,'no remote assets');
like($html,qr/<svg /,'native generated figures');
my %ids;
my @ids = $html =~ /\bid="([^"]+)"/g;
$ids{$_}++ for @ids;
ok(!(grep { $_ > 1 } values %ids),'SVG identifiers do not collide in the notebook');
like($html,qr/minmax\(0,1\.5fr\)/,'grid figures can shrink within the viewport');
like($html,qr/independent verification/,'verification details');
my $injected = Skein::Model->from_text('title "<script>alert(1)</script>"; noise u ~ 1/2; query q = P(u);');
my $safe = Skein::Report->new(Skein::Engine->new($injected))->html;
unlike($safe,qr/<script>/,'title cannot inject HTML');
like($safe,qr/&lt;script&gt;/,'title escaped');
like(Skein::Render->model_dot($model),qr/digraph skein/,'DOT structural graph');
my $dir = tempdir(CLEANUP => 1);
$report->save("$dir/report.html",$data);
is(sha256_hex(read_text("$dir/report.html")),sha256_hex($html),'atomic report preserves the computed snapshot');
done_testing;
