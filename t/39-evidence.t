use strict;
use warnings;
use Test::More;
use File::Temp qw(tempdir);
use File::Path qw(make_path);
use Skein::Evidence;
use Skein::Util qw(write_text deep_copy digest);

my $dir = tempdir(CLEANUP=>1);
write_text("$dir/lib/A.pm","package A; 1;\n");
write_text("$dir/README.md","hello\n");
write_text("$dir/.runtime/ignored","temporary\n");
my $manifest = Skein::Evidence->source_manifest($dir);
is(scalar @{$manifest->{files}},2,'exact source inventory');
ok(Skein::Evidence->verify_source($dir,$manifest)->{verified},'unchanged source verified');
write_text("$dir/.runtime/ignored","different\n");
ok(Skein::Evidence->verify_source($dir,$manifest)->{verified},'runtime output excluded by explicit policy');
write_text("$dir/lib/A.pm","package A; 2;\n");
ok(!eval { Skein::Evidence->verify_source($dir,$manifest); 1 },'post-run source edit invalidates acceptance');
write_text("$dir/lib/A.pm","package A; 1;\n");
write_text("$dir/lib/B.pm","package B; 1;\n");
ok(!eval { Skein::Evidence->verify_source($dir,$manifest); 1 },'new source file invalidates acceptance');
my $current = Skein::Evidence->source_manifest($dir);
my $data = {passed=>1,tests=>{passed=>1,assertions=>2},campaign=>{passed=>1,assertions=>3}};
my $bundle = Skein::Evidence->bundle($current,$data);
ok(Skein::Evidence->verify_bundle($dir,$bundle)->{verified},'successful source-bound receipt');
my $corrupt = deep_copy($bundle);
$corrupt->{payload}{data}{passed}=0;
ok(!eval { Skein::Evidence->verify_bundle($dir,$corrupt); 1 },'modified evidence rejected');
$corrupt->{sha256}=digest($corrupt->{payload});
ok(!eval { Skein::Evidence->verify_bundle($dir,$corrupt); 1 },'rehashed unsuccessful run rejected');
ok(!eval { Skein::Evidence->file_record($dir,'../secret'); 1 },'parent traversal rejected');
ok(!eval { Skein::Evidence->file_record($dir,'/secret'); 1 },'absolute artifact path rejected');
ok(!eval { Skein::Evidence->file_record($dir,'lib//A.pm'); 1 },'empty path component rejected');
write_text("$dir/.gitattributes","* text=auto eol=lf\n");
my $attributes = Skein::Evidence->source_manifest($dir);
ok(grep($_->{path} eq '.gitattributes', @{$attributes->{files}}),
    'checkout byte policy is part of source identity');
write_text("$dir/.gitattributes","* text=auto eol=crlf\n");
ok(!eval { Skein::Evidence->verify_source($dir,$attributes); 1 },
    'changed checkout byte policy invalidates acceptance');
done_testing;
