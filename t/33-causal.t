use strict;
use warnings;
use Test::More;
use Skein::Model;
use Skein::Engine;
use Skein::Causal;
use Skein::Expr qw(var const);

my $m = Skein::Model->from_text('noise u ~ 1/4; noise c ~ 1/2; node x = c; node y = x | u;');
my $c = Skein::Causal->new(Skein::Engine->new($m));
my $r = $c->response('x',var('y'));
is($r->{average_effect},'3/4','average effect from paired worlds');
is($r->{probability_of_necessity}{probability},'3/4','necessity among factual treated successes');
is($r->{probability_of_sufficiency}{probability},'1','sufficiency among factual untreated failures');
is($r->{strata}[3]{probability},'1/4','always present stratum');
ok($r->{monotone_increasing},'structural monotonicity');
ok($c->verify_response($r)->{verified},'independent paired-world check');
my $xor = Skein::Model->from_text('noise u ~ 1/4; node x = 0; node y = x ^ u;');
$c = Skein::Causal->new(Skein::Engine->new($xor));
$r = $c->response('x',var('y'));
is($r->{average_effect},'1/2','effects can contain both signs');
is($r->{strata}[2]{probability},'1/4','harmed stratum retained');
ok(!$r->{monotone_increasing},'structural harm defeats monotonicity');
is($r->{probability_of_necessity}{status},'undefined','zero-mass factual population explicit');
ok($c->verify_response($r)->{verified},'nonmonotone response checked');
my $zero = Skein::Model->from_text('noise u ~ 0; node x = 0; node y = x ^ u;');
$r = Skein::Causal->new(Skein::Engine->new($zero))->response('x',var('y'));
is($r->{strata}[2]{probability},'0','zero-prior harm has zero mass');
ok(!$r->{monotone_increasing},'zero-prior structural counterexample still retained');
eval { $c->response('u',var('y')) };
like($@,qr/must be endogenous/,'treatment equation must be replaceable');
eval { $c->response('x',var('y'),factual => const(0)) };
like($@,qr/impossible evidence/,'undefined entire response refused');
done_testing;
